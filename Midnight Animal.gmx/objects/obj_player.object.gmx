        <arguments>
          <argument>
            <kind>1</kind>
            <string>x=mouse_x
y=mouse_y
if fps
    {
    F+=fps
    T+=1
    }

draw_sprite(sprite_index,image_single,mouse_x,mouse_y)

draw_set_color(c_white)
draw_set_font(font2)
draw_text(view_xview,view_yview-2,'Current FPS: '+ string(fps))
draw_text(view_xview,view_yview+13,'Average FPS: '+ string(F/T))
draw_text(view_xview,view_yview+28,'Light renders: '+string(global.light_renders))
draw_text(view_xview,view_yview+43,'Specular Highlights:')
if global.LS_spec{
    draw_set_color(c_green)
    draw_text(view_xview+string_width('Specular Highlights: '),view_yview+43,"ON")
    draw_set_color(c_white)
    }
else{
    draw_set_color(c_red)
    draw_text(view_xview+string_width('Specular Highlights: '),view_yview+43,"OFF")
    draw_set_color(c_white)
    }

draw_text(view_xview,view_yview+58,'Light Bloom:')
if global.LS_bloom{
    draw_set_color(c_green)
    draw_text(view_xview+string_width('Light Bloom: '),view_yview+58,"ON")
    draw_set_color(c_white)
    }
else{
    draw_set_color(c_red)
    draw_text(view_xview+string_width('Light Bloom: '),view_yview+58,"OFF")
    draw_set_color(c_white)
    }
draw_text(view_xview,view_yview+73,'Emissive Glow:')
if global.LS_glow {
    draw_set_color(c_green)
    draw_text(view_xview+string_width('Emissive Glow: '),view_yview+73,"ON")
    draw_set_color(c_white)
    }
else{
    draw_set_color(c_red)
    draw_text(view_xview+string_width('Emissive Glow: '),view_yview+73,"OFF")
    draw_set_color(c_white)
    }
draw_text(view_xview,view_yview+88,'Video Memory Usage: '+string(vmem)+" mb")
</string>
          </argument>
